# --- MLflow (self-hosted, see infra/aws/README.md) ---
# In production (on the EC2 host itself): http://127.0.0.1:5000 — the default.
# For local dev against the same server: SSH-tunnel first, e.g.
#   ssh -L 5000:127.0.0.1:5000 -i ~/.ssh/forwardforecasting.pem ubuntu@100.115.161.103
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_S3_BUCKET=windward-mlflow-artifacts-ff

# --- LLM provider (LiteLLM router) ---
LLM_PROVIDER=bedrock
BEDROCK_REGION=eu-west-1

# --- Data sources ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
ENTSOE_API_TOKEN=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- AWS ---
# In production: picked up automatically from the EC2 instance role, no keys needed.
# Locally: your own AWS CLI profile/credentials.
AWS_REGION=eu-west-1
DYNAMODB_TABLE_SESSIONS=windward-agent-sessions
