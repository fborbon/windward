# --- Azure ML / MLflow ---
# Auth via `az login` + DefaultAzureCredential — no key needed.
AZURE_SUBSCRIPTION_ID=6ac19ec5-1fb2-487a-8208-70172e593da9
AZURE_RESOURCE_GROUP=rg-windward
AZURE_ML_WORKSPACE=windward-mlflow
MLFLOW_TRACKING_URI=azureml://swedencentral.api.azureml.ms/mlflow/v1.0/subscriptions/6ac19ec5-1fb2-487a-8208-70172e593da9/resourceGroups/rg-windward/providers/Microsoft.MachineLearningServices/workspaces/windward-mlflow

# --- LLM provider (LiteLLM router) ---
# Default: reuse existing AWS Bedrock Nova setup (see global-news-agent) — cheap, already working, keeps Azure OpenAI (not free-tier) out of the loop.
LLM_PROVIDER=bedrock
BEDROCK_REGION=eu-west-1
# Optional, only if you decide to spend part of the Azure trial credit exercising Azure OpenAI:
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# LLM_PROVIDER=azure_openai  (auth via DefaultAzureCredential, no key needed either)

# --- Data sources ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
ENTSOE_API_TOKEN=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- AWS (DynamoDB session store, existing credentials/profile) ---
AWS_REGION=eu-west-1
DYNAMODB_TABLE_SESSIONS=windward-agent-sessions
